# Pixabay image search (server-side only)
PIXABAY_KEY=

# Password for the /analytics dashboard. Required in every deployment.
# Use a different value per Vercel environment if you want separate access.
ANALYTICS_PASSWORD=

# Optional: long random string used to sign admin session cookies.
# Falls back to ANALYTICS_PASSWORD when omitted.
ANALYTICS_SESSION_SECRET=

# Optional: force a data namespace ("production", "preview", "development").
# Normally derived from VERCEL_ENV.
ANALYTICS_ENV=

# Upstash Redis REST credentials (production). Locally, analytics fall back to
# .data/analytics-dev.json. Vercel integrations may name these KV_REST_API_*,
# UPSTASH_REDIS_REST_*, or a custom-prefixed variant; all are auto-detected.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
